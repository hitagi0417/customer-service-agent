LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=
LLM_MODEL_NAME=replace-with-your-model-name

# API 服务配置
# production 环境必须设置一个足够长的随机 SERVICE_API_KEY。
APP_ENV=development
SERVICE_API_KEY=replace-with-a-long-random-api-key
API_MAX_CONCURRENCY=1
API_REQUEST_TIMEOUT_SECONDS=60

EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
KNOWLEDGE_DIR=knowledge
DATABASE_PATH=data/customer_service.db
CHUNK_SIZE=400
CHUNK_OVERLAP=80
KNOWLEDGE_MIN_CONTENT_CHARS=10
INGESTION_REPORT_PATH=data/ingestion_report.json
RAG_TOP_K=3
RAG_MIN_SCORE=0.45
RAG_KEYWORD_WEIGHT=0.30
RAG_MIN_KEYWORD_SCORE=0.35
RAG_CANDIDATE_MULTIPLIER=4
RAG_ENABLE_RERANKER=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANK_CANDIDATE_K=10
INTENT_MIN_CONFIDENCE=0.60
MEMORY_RECENT_MESSAGES=8
MEMORY_SUMMARY_TRIGGER_TOKENS=2000
MEMORY_MAX_SUMMARY_CHARS=2000
AGENT_MAX_STEPS=3

# 本地 HTML 文件无需打开这个开关。
# 只有需要从 URL 抓取网页时才设置为 true。
ENABLE_WEB_INGESTION=false
WEB_SOURCES_PATH=knowledge/web_sources.json
WEB_ALLOWED_DOMAINS=docs.example.com
